## Copy this file to android/key.properties (same folder) and fill in your
## real values. android/key.properties is git-ignored and must never be
## committed - it holds the passwords for your release signing key.
##
## storeFile is resolved relative to the android/app/ directory, or you can
## give it an absolute path.

storePassword=REPLACE_WITH_KEYSTORE_PASSWORD
keyPassword=REPLACE_WITH_KEY_PASSWORD
keyAlias=REPLACE_WITH_KEY_ALIAS
storeFile=upload-keystore.jks
